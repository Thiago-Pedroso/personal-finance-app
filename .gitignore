# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Contrato de operação do Claude Code: versionar neste projeto (colaborativo),
# sobrescrevendo a regra do gitignore global do usuário.
!CLAUDE.md

# Credenciais e segredos (NUNCA commitar) — padrões amplos de propósito
.env
.env.*
!.env.example
credentials*.json
service_account*.json
*-service-account*.json
token.json
*.pem

# Node / frontend build
node_modules/
frontend/dist/

# Ferramentas locais de agente (skills instaladas localmente; não versionar)
.agents/
.claude/
skills-lock.json

# ---- data/: BLINDADO para repo público de finanças ----------------------------
# Ignora TUDO em data/ exceto os fixtures SINTÉTICOS em data/seed/. Assim nenhum dado
# real (ledger, relatórios, sync_state, orçamento, fila) cabe num commit — nem mesmo
# em arquivos novos que ninguém previu. A fonte da verdade dos dados é o Google Sheets.
data/*
!data/seed/
